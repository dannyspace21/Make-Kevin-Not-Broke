# =============================================================================
# .env.example  ->  copy to ".env" and fill in your own values:
#     cp .env.example .env
# NEVER commit .env (it's in .gitignore). NEVER paste keys into chats/issues.
# =============================================================================

# ---- Alpaca market data (REQUIRED for live data) ---------------------------
# Free account: https://alpaca.markets  ->  dashboard -> API Keys -> Generate.
# Paper-trading keys work fine; this app only READS market data.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex = free real-time feed. sip = full market (paid plan).
ALPACA_FEED=iex
# Leave empty: demo mode turns on automatically when keys are missing.
# DEMO_MODE=false

# ---- App security -------------------------------------------------------------
# Set a password if anyone besides you can reach the port (HTTP Basic Auth).
APP_USER=kevin
APP_PASSWORD=
# Set to true ONLY if running behind a reverse proxy (nginx, Traefik, Caddy).
TRUST_PROXY=false
# Extra allowed browser origins for the WebSocket, comma separated.
# ALLOWED_ORIGINS=https://kevin.example.com

# ---- Ransomware / SEC 8-K watchdog -------------------------------------------
RANSOM_MONITOR_ENABLED=true
RANSOM_POLL_MINUTES=30
RANSOM_LOOKBACK_DAYS=21
# SEC REQUIRES a User-Agent with contact info, e.g. "KevinBot you@example.com"
SEC_USER_AGENT=
HIBP_ENABLED=true
# Optional JSON feeds (if you have API/export access - see README):
RANSOMDB_API_URL=
RANSOMDB_API_KEY=
WATCHGUARD_FEED_URL=
COMPARITECH_FEED_URL=
DARKWEBIQ_FEED_URL=
DARKWEBIQ_API_KEY=
# Optional Discord/Slack incoming webhook for alerts:
ALERT_WEBHOOK_URL=

# ---- AI co-pilot (optional) - use ANY number of AIs at once ----------------
# Every provider below that has a key (and a model) appears in the AI panel's
# drop-down. Tick "Ask every AI at once" to compare them; each gets its own
# paper wallet on the leaderboard. Model names change often - check your
# provider's model list if you get a "model not found" error.

# Claude (Anthropic) - https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ChatGPT (OpenAI) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (Google) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Up to 3 more "OpenAI-compatible" AIs. Examples of base URLs:
#   Grok (xAI)      https://api.x.ai/v1
#   Mistral         https://api.mistral.ai/v1
#   DeepSeek        https://api.deepseek.com/v1
#   Groq            https://api.groq.com/openai/v1
#   OpenRouter      https://openrouter.ai/api/v1      (one key -> hundreds of models)
#   Ollama (local)  http://host.docker.internal:11434/v1   (no key needed; use http://localhost:11434/v1 without Docker)
CUSTOM_AI_1_NAME=
CUSTOM_AI_1_BASE_URL=
CUSTOM_AI_1_API_KEY=
CUSTOM_AI_1_MODEL=
CUSTOM_AI_2_NAME=
CUSTOM_AI_2_BASE_URL=
CUSTOM_AI_2_API_KEY=
CUSTOM_AI_2_MODEL=
CUSTOM_AI_3_NAME=
CUSTOM_AI_3_BASE_URL=
CUSTOM_AI_3_API_KEY=
CUSTOM_AI_3_MODEL=

# Which one is selected first: anthropic | openai | gemini | custom1 | custom2 | custom3
AI_DEFAULT_PROVIDER=
